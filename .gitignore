# Python
.venv/
__pycache__/
*.pyc

# Shell scripts are private by default.
# The public UVM regression entry point is explicitly version-controlled below.
*.sh
!verif/uvm/run_regression.sh

# Verilator
obj_dir*/
sim_build/

# cocotb
results.xml

# Waveforms
*.vcd
*.fst

# Build
build/

# OpenROAD generated files
logs/
reports/
results/

# Editors / OS
.vscode/
.DS_Store

# Thesis and related
rtl/private
tb/private
scripts/

# Generated NTT / INTT regression outputs
verilog_ntt_out_new.mem
verilog_intt_out_new.mem

# Yosys / ASIC / synthesis generated files
*.odb
*.def
*.gds
*.gdsii
*.spef
*.sdf
*_synth.v
*_mapped.v
*_route.v
*_final.v
*.json

# ORFS configuration
# Publish Config.Public.mk instead because private Config.mk files may reference private IP.
asic/orfs/**/Config.mk

# PPA sweep
asic/**/private/*.xlsx

# UVM generated regression / coverage artifacts
verif/uvm/coverage_data/
verif/uvm/coverage_report/
verif/uvm/regression_logs/
coverage.dat
